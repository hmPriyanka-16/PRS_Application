<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteMaster.master.cs" Inherits="PRSwebapp.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style type="text/css">
        body {
            background-color: #f4f0fa;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Fixed header - smaller size */
        .header {
            background: linear-gradient(90deg, #ffffff, #e6e0ff);
            padding: 12px 30px; /* reduced padding */
            display: flex;
            align-items: center;
            justify-content: flex-start; 
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 10px 10px 0 0;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            border: 1px solid rgba(108,92,231,0.3);
        }

        /* Logo slightly smaller */
        .logo {
            width: 140px; /* reduced from 180px */
            height: auto;
            z-index: 2;
        }

        .hospital-name-container {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .hospital-name {
            font-size: 24px; /* reduced from 28px */
            font-weight: bold;
            color: #6c5ce7;
            text-shadow: 2px 2px 3px rgba(0,0,0,0.2);
            background: linear-gradient(90deg, #5a3fb5, #7a4eb8, #5a3fb5);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 2.5s linear infinite, glow 2s ease-in-out infinite;
        }

        @keyframes shine {
            0% { background-position: 200% center; }
            100% { background-position: -200% center; }
        }

        @keyframes glow {
            0%,100% {
                text-shadow: 2px 2px 3px rgba(0,0,0,0.2),
                             0 0 4px rgba(90,63,181,0.4),
                             0 0 8px rgba(90,63,181,0.3);
            }
            50% {
                text-shadow: 2px 2px 3px rgba(0,0,0,0.2),
                             0 0 8px rgba(90,63,181,0.5),
                             0 0 16px rgba(90,63,181,0.4);
            }
        }

        /* Content padding so content is not hidden behind header */
        .content {
            width: 100%;
            margin: 20px auto;
            flex: 1;
            padding-top: 70px; /* reduced for smaller header */
        }

        .auto-style2 { width: 100%; }
        .auto-style3 { height: 554px; }

        .footer {
            background: linear-gradient(90deg, #e6e0ff, #ffffff);
            text-align: center;
            padding: 15px 0;
            font-size: 14px;
            font-weight: bold;
            box-shadow: 0 -4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 0 0 10px 10px;
            position: relative;
            border: 1px solid rgba(108,92,231,0.3);
        }

        .footer-text-container {
            position: relative;
            display: inline-block;
        }

        .footer-text {
            color: #6c5ce7;
            background: linear-gradient(90deg, #5a3fb5, #7a4eb8, #5a3fb5);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: footerShine 3s linear infinite, footerGlow 2.5s ease-in-out infinite;
        }

        @keyframes footerShine {
            0% { background-position: 200% center; }
            100% { background-position: -200% center; }
        }

        @keyframes footerGlow {
            0%,100% {
                text-shadow: 0 0 2px rgba(90,63,181,0.3),
                             0 0 4px rgba(90,63,181,0.25);
            }
            50% {
                text-shadow: 0 0 6px rgba(90,63,181,0.45),
                             0 0 12px rgba(90,63,181,0.35);
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">
        <!-- Fixed Header -->
        <div class="header">
            <img alt="sakralogo" class="logo" src="Images/Sakra-logo.png" />
            <div class="hospital-name-container">
                <span class="hospital-name">SAKRA WORLD HOSPITAL</span>
            </div>
        </div>

        <!-- Main content -->
        <div class="content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <table class="auto-style2">
                    <tr>
                        <td class="auto-style3"></td>
                    </tr>
                </table>
            </asp:ContentPlaceHolder>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-text-container">
                <span class="footer-text">&copy; 2025 SAKRA WORLD HOSPITAL. All rights reserved.</span>
            </div>
        </div>
    </form>
</body>
</html>
