<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteMaster.master.cs" Inherits="PRSwebapp.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Sakra World Hospital</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <style>
        /* ===== GLOBAL STYLES ===== */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        html, body { height: 100%; background: #f4f0fa; overflow-x: hidden; }
        a { text-decoration: none; }
        a:hover { text-decoration: none; }

        /* ===== HEADER ===== */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background: linear-gradient(90deg, #ffffff, #e6e0ff);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 15px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            z-index: 1000;
            border-bottom: 1px solid rgba(108,92,231,0.3);
        }

        .header-left, .header-center, .header-right { display: flex; align-items: center; }

        .header-center { flex: 1; justify-content: center; }

        .header-right { gap: 10px; }

        .logo { width: 100px; height: auto; }

        .hospital-name {
            font-size: 24px;
            font-weight: bold;
            color: #6c5ce7;
            text-align: center;
            white-space: nowrap;
            background: linear-gradient(90deg, #5a3fb5, #7a4eb8, #5a3fb5);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 2.5s linear infinite, glow 2s ease-in-out infinite;
        }

        @keyframes shine {
            0% { background-position: 200% center; }
            100% { background-position: -200% center; }
        }
        @keyframes glow {
            0%,100% { text-shadow: 1px 1px 3px rgba(0,0,0,0.2), 0 0 4px rgba(90,63,181,0.4); }
            50% { text-shadow: 1px 1px 3px rgba(0,0,0,0.2), 0 0 8px rgba(90,63,181,0.5); }
        }

        .user-logo {
            width: 30px; height: 30px;
            background: #6c5ce7;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 14px;
        }

        .user-info { font-weight: 600; color: #4b39c2; font-size: 14px; }

        .logout-btn {
            background: #6c5ce7;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: 0.3s;
        }

        .logout-btn:hover { background: #5947c2; }

        /* ===== TOP NAVIGATION ===== */
        .top-nav {
            position: fixed;
            top: 60px;
            left: 0;
            width: 100%;
            background: #6c5ce7;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            z-index: 999;
            flex-wrap: wrap;
        }

        .top-nav a {
            color: white;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 14px;
            transition: 0.3s;
        }

        .top-nav a:hover, .top-nav a.active { background: #5947c2; }

        .menu-icon {
            font-size: 22px;
            color: white;
            cursor: pointer;
            margin-right: 10px;
            transition: 0.3s;
        }
        .menu-icon:hover { color: #d1c4ff; }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 106px;
            left: -180px;
            width: 180px;
            height: calc(100% - 106px);
            background: #6c5ce7;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 15px 0;
            transition: 0.3s;
            box-shadow: 4px 0 8px rgba(0,0,0,0.2);
            z-index: 998;
        }

        .sidebar.open { left: 0; }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            color: white;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            transition: 0.3s;
        }

        .top-nav a.active {
    background: #e84118 !important;   /* Red */
    color: white !important;
}

.sidebar a.active {
    background: #e84118 !important;   /* Red */
    color: white !important;
}

.top-nav a:hover,
.sidebar a:hover {
    background: #ff5733 !important;   /* Slightly lighter red */
}


        /* ===== CONTENT ===== */
        .content {
            margin-top: 80px;
            padding: 15px 20px;
            transition: margin-left 0.3s ease;
        }
        .content.shift { margin-left: 180px !important; }

        /* Reduced gap for dashboard page */
        body.dashboard-page .content { margin-top: 80px; }

        /* ===== FOOTER ===== */
        .footer {
            width: 100%;
            background: linear-gradient(90deg, #e6e0ff, #ffffff);
            padding: 15px 0;
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            color: #6c5ce7;
            border-top: 1px solid rgba(108,92,231,0.3);
            box-shadow: 0 -4px 6px rgba(0, 0, 0, 0.1);
        }

        /* ===== RESPONSIVE ===== */
        @media(max-width:768px){
            .sidebar { width: 160px; }
            .content.shift { margin-left: 160px !important; }
            .top-nav { flex-wrap: wrap; }
        }

        .sidebar-logout-btn {
    margin: 10px 15px 0 15px;
    padding: 8px;
    width: calc(100% - 30px);
    background: #6c5ce7;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s;
    text-align: left;
}

.sidebar-logout-btn:hover {
    background: #e84118;
}


    </style>
</head>

<body class="<%= this.Page.Title == "Dashboard" ? "dashboard-page" : "" %>">
    <form id="form1" runat="server">
        <!-- HEADER -->
        <div class="header">
            <div class="header-left">
                <img src="Images/Sakra-logo.png" class="logo" alt="Logo" />
            </div>

            <div class="header-center">
                <span class="hospital-name">SAKRA WORLD HOSPITAL</span>
            </div>

            <div class="header-right">
                <div class="user-logo"><i class="fa-solid fa-user"></i></div>
                <asp:Label ID="lblUserName" runat="server" Text="Guest" CssClass="user-info"></asp:Label>
                <asp:Button ID="btnLogout" runat="server" Text="Logout" CssClass="logout-btn" OnClick="btnLogout_Click" />
            </div>
        </div>

        <!-- TOP NAVIGATION -->
      <div id="topNav" runat="server" class="top-nav">
    <div class="menu-icon" onclick="toggleSidebar()"><i class="fa fa-bars"></i></div>
    <a href="dashboard.aspx">Dashboard</a>
    <a href="Supplier.aspx">Supplier Registration</a>
    <a href="supplierdetails.aspx">Supplier PO Entry</a>
    <a href="PRS_Request.aspx">Vendor PRS</a>
    <a href="pendingtask.aspx">My Tasks</a>
    <a href="CompletedTask.aspx">Completed PRS</a>
    <a href="Inprogress.aspx">In Progress</a>
    <a href="EmpClaim.aspx">Claim PRS</a>
</div>
<div id="sidebar" runat="server" class="sidebar">
    <a href="dashboard.aspx"><i class="fa fa-home"></i> Dashboard</a>
    <a href="Supplier.aspx"><i class="fa fa-users"></i> Supplier Registration</a>
    <a href="supplierdetails.aspx"><i class="fa fa-plus-circle"></i> Supplier PO Entry</a>
    <a href="PRS_Request.aspx"><i class="fa fa-plus-circle"></i> Vendor PRS</a>
    <a href="pendingtask.aspx"><i class="fa fa-list"></i> Pending Tasks</a>
    <a href="CompletedTask.aspx"><i class="fa fa-check"></i> Completed PRS</a>
    <a href="Inprogress.aspx"><i class="fa fa-plus-circle"></i> In Progress</a>
    <a href="EmpClaim.aspx"><i class="fa fa-plus-circle"></i> Claim PRS</a>
    
    <!-- LOGOUT BUTTON IN SIDEBAR -->
    <asp:Button ID="btnSidebarLogout" runat="server" Text="Logout" CssClass="sidebar-logout-btn" OnClick="btnLogout_Click" />
</div>



        <!-- MAIN CONTENT -->
        <div class="content" id="mainContent">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>

        <!-- FOOTER -->
        <div class="footer">&copy; 2025 SAKRA WORLD HOSPITAL. All rights reserved.</div>
    </form>

    <script>
        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("open");
            document.getElementById("mainContent").classList.toggle("shift");
        }
    </script>
</body>
</html>
