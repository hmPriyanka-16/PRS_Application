<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteMaster.master.cs" Inherits="PRSwebapp.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Sakra World Hospital</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <style>
        /* ===== GLOBAL STYLES ===== */
        * { box-sizing: border-box; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin-left: 0;
            margin-right: 0;
            margin-bottom: 0;
        }
        html, body { height: 100%; background: #f4f0fa; overflow-x: hidden; }
        a { text-decoration: none; }
        a:hover { text-decoration: none; }

        /* ===== HEADER ===== */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;
            background: linear-gradient(90deg, #ffffff, #e6e0ff);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 15px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            z-index: 1000;
            border-bottom: 1px solid rgba(108,92,231,0.3);
        }

        .header-left, .header-center, .header-right { display: flex; align-items: center; }

        .header-center { flex: 1; justify-content: center; }

        .header-right { gap: 10px; }

        .logo { width: 100px; height: auto; }

        .hospital-name {
            font-size: 24px;
            font-weight: bold;
            color: #6c5ce7;
            text-align: center;
            white-space: nowrap;
            background: linear-gradient(90deg, #5a3fb5, #7a4eb8, #5a3fb5);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 2.5s linear infinite, glow 2s ease-in-out infinite;
        }

        @keyframes shine {
            0% { background-position: 200% center; }
            100% { background-position: -200% center; }
        }
        @keyframes glow {
            0%,100% { text-shadow: 1px 1px 3px rgba(0,0,0,0.2), 0 0 4px rgba(90,63,181,0.4); }
            50% { text-shadow: 1px 1px 3px rgba(0,0,0,0.2), 0 0 8px rgba(90,63,181,0.5); }
        }

        .user-logo {
            width: 30px; height: 30px;
            background: #6c5ce7;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 14px;
        }

        .user-info { font-weight: 600; color: #4b39c2; font-size: 14px; }

        .logout-btn {
            background: #6c5ce7;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: 0.3s;
        }

        .logout-btn:hover { background: #5947c2; }

        /* ===== TOP NAVIGATION ===== */
        .top-nav {
            position: fixed;
            top: 60px;
            left: 0;
            width: 100%;
            background: #6c5ce7;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            z-index: 999;
            flex-wrap: wrap;
        }

        .top-nav a {
            color: white;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 14px;
            transition: 0.3s;
        }

        .top-nav a:hover, .top-nav a.active { background: #5947c2; }

        .menu-icon {
            font-size: 22px;
            color: white;
            cursor: pointer;
            margin-right: 10px;
            transition: 0.3s;
        }
        .menu-icon:hover { color: #d1c4ff; }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 106px;
            left: -180px;
            width: 180px;
            height: calc(100% - 106px);
            background: #6c5ce7;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 15px 0;
            transition: 0.3s;
            box-shadow: 4px 0 8px rgba(0,0,0,0.2);
            z-index: 998;
        }

        .sidebar.open { left: 0; }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            color: white;
            font-weight: 600;
            border-radius: 8px;
            font-size: 14px;
            transition: 0.3s;
        }

        .top-nav a.active {
    background: #e84118 !important;   /* Red */
    color: white !important;
}

.sidebar a.active {
    background: #e84118 !important;   /* Red */
    color: white !important;
}

.top-nav a:hover,
.sidebar a:hover {
    background: #ff5733 !important;   /* Slightly lighter red */
}


        /* ===== CONTENT ===== */
        .content {
            margin-top: 80px;
            padding: 15px 20px;
            transition: margin-left 0.3s ease;
        }
        .content.shift { margin-left: 180px !important; }

        /* Reduced gap for dashboard page */
        body.dashboard-page .content { margin-top: 80px; }

        /* ===== FOOTER ===== */
        .footer {
            width: 100%;
            background: linear-gradient(90deg, #e6e0ff, #ffffff);
            padding: 15px 0;
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            color: #6c5ce7;
            border-top: 1px solid rgba(108,92,231,0.3);
            box-shadow: 0 -4px 6px rgba(0, 0, 0, 0.1);
        }

        /* ===== RESPONSIVE ===== */
        @media(max-width:768px){
            .sidebar { width: 160px; }
            .content.shift { margin-left: 160px !important; }
            .top-nav { flex-wrap: wrap; }
        }

        .sidebar-logout-btn {
    margin: 10px 15px 0 15px;
    padding: 8px;
    width: calc(100% - 30px);
    background: #6c5ce7;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s;
    text-align: left;
}

.sidebar-logout-btn:hover {
    background: #e84118;
}
.hospital-dropdown {
    padding: 4px 6px;
    border-radius: 6px;
    border: 1px solid #6c5ce7;
    font-weight: 600;
    font-size: 13px;
    color: #4b39c2;
}.user-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
}

.user-menu {
    position: absolute;
    top: 45px;
    right: 0;
    background: white;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    padding: 10px;
    display: none;
    z-index: 2000;
}

.user-menu.show {
    display: block;
}
.user-info {
    font-weight: 600;
    color: #4b39c2;
    font-size: 14px;
    text-decoration: underline;   /* ✅ underline username */
    cursor: pointer;              /* optional – shows clickable */
}
.hospital-dropdown {
    margin-bottom: 12px; /* Adjust the gap as needed */
}



.user-menu-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
}

.user-menu-row label {
    font-size: 13px;
    font-weight: 600;
    color: #4b39c2;
    min-width: 60px;   /* keeps labels aligned */
}

.user-menu-row .hospital-dropdown {
    flex: 1;
}
.user-name-role {
    display: flex;
    flex-direction: column; /* stack username above role */
    align-items: center;    /* center under the icon */
    gap: 2px;               /* small space between username and role */
}

.user-role {
    font-size: 13px;        /* smaller than username */
    font-weight: 500;
    color: darkred;         /* theme color */
}
    </style>
        </asp:ContentPlaceHolder>
</head>


<body class="<%= this.Page.Title == "Dashboard" ? "dashboard-page" : "" %>">
    <form id="form1" runat="server" defaultbutton="">

        <!-- ===== HEADER ===== -->
        <div class="header">
            <div class="header-left">
                <img id="imgHospitalLogo" runat="server" class="logo" alt="Hospital Logo" />
            </div>

            <div class="header-center">
                <asp:Label ID="lblHospitalName" runat="server" CssClass="hospital-name" />
            </div>

            <!-- ===== HEADER RIGHT ===== -->
            <div class="header-right" style="position:relative; gap:10px;">

                <!-- USER NAME / ICON -->
                <div class="user-trigger" onclick="toggleUserMenu()">
    <div class="user-logo">
        <i class="fa-solid fa-user"></i>
    </div>
    
    <!-- Vertical stack for username and role -->
    <div class="user-name-role">
        <asp:Label ID="lblUserName" runat="server" CssClass="user-info" />
        <asp:Label ID="lblUserRole" runat="server" CssClass="user-role" />
    </div>
</div>

                <!-- 🔴 LOGOUT (NAME SIDE - ALWAYS VISIBLE) -->
                <asp:Button ID="btnHeaderLogout"
                    runat="server"
                    Text="Logout"
                    CommandName="Masterlogout"
                    OnCommand="Master_OnCommand"
                    CssClass="logout-btn"
                    CausesValidation="false"
                    UseSubmitBehavior="false" />

                <!-- USER DROPDOWN -->
                <div id="userMenu" class="user-menu">

                   <div class="user-menu-row">
    <label>Role :</label>
    <asp:DropDownList ID="ddlRole"
        runat="server"
        AutoPostBack="false"
        OnSelectedIndexChanged="ddlRole_SelectedIndexChanged"
        CssClass="hospital-dropdown">
    </asp:DropDownList>
</div>

<div class="user-menu-row">
    <label>Hospital :</label>
    <asp:DropDownList ID="ddlHospital"
        runat="server"
        AutoPostBack="true"
        OnSelectedIndexChanged="ddlHospital_SelectedIndexChanged"
        CssClass="hospital-dropdown">
    </asp:DropDownList>
</div>
                    <asp:Button ID="btnSwitchRole"
    runat="server"
    Text="Switch Role"
    CssClass="logout-btn"
    OnClick="btnSwitchRole_Click"
    CausesValidation="false" />

                    <!-- 🔴 LOGOUT (DROPDOWN) -->
                    
                </div>

            </div>
        </div>

        <!-- ===== TOP NAVIGATION ===== -->
        <div id="topNav" runat="server" class="top-nav">
            <div class="menu-icon" onclick="toggleSidebar()">
                <i class="fa fa-bars"></i>
            </div>
            <a href="dashboard.aspx">Dashboard</a>
            <a href="pendingtask.aspx">My Tasks</a>
            <a href="Inprogress.aspx">In Progress</a>
            <a href="CompletedTask.aspx">Completed PRS</a>
            <a href="PRS_Request.aspx">Vendor PRS</a>
            <a href="EmpClaim.aspx">Claim PRS</a>
<a href="rejecthold.aspx?status=rejected">Rejected PRS</a>
<a href="hold.aspx?status=hold">Hold PRS</a>
            <a href="query.aspx?status=query">Query PRS</a>

            <a id="lnkSupplierDetailsTop"
   runat="server"
   href="supplierdetails.aspx">
    PO Entry
</a>
            <a id="lnkSupplierregTop"
   runat="server" href="Supplier.aspx">Supplier Registration</a>
            <a id="lnkRoleDetailsTop"
   runat="server"
   href="ROLEDETAILS.aspx">
   Role Details
</a>


        </div>

        <!-- ===== SIDEBAR ===== -->
        <div id="sidebar" runat="server" class="sidebar">
            <a href="dashboard.aspx"><i class="fa fa-home"></i> Dashboard</a>
            <a href="pendingtask.aspx"><i class="fa fa-list"></i> My Tasks</a>
            <a href="Inprogress.aspx"><i class="fa fa-plus-circle"></i> In Progress</a>
            <a href="CompletedTask.aspx"><i class="fa fa-check"></i> Completed PRS</a>
            <a href="PRS_Request.aspx"><i class="fa fa-plus-circle"></i> Vendor PRS</a>
            <a href="EmpClaim.aspx"><i class="fa fa-plus-circle"></i> Claim PRS</a>
<a href="rejecthold.aspx?status=rejected"><i class="fa fa-times-circle"></i> Rejected PRS</a>
<a href="hold.aspx?status=hold"><i class="fa fa-pause-circle"></i> Hold PRS</a>
            <a id="lnkSupplierDetailsSide"
   runat="server"
   href="supplierdetails.aspx">
   <i class="fa fa-plus-circle"></i> Supplier PO Entry
</a>
            <a id="lnkSupplierreg"
   runat="server" href="Supplier.aspx"><i class="fa fa-users"></i> Supplier Registration</a>
            <a id="lnkRoleDetailsSide"
   runat="server"
   href="ROLEDETAILS.aspx">
   <i class="fa fa-user-shield"></i> Employee Role Details
</a>


            <!-- SIDEBAR LOGOUT -->
            <asp:LinkButton ID="Button1" runat="server"
                CommandName="Masterlogout"
                OnCommand="Master_OnCommand"
                CssClass="sidebar-link"
                CausesValidation="false"
                UseSubmitBehavior="false">
                <i class="fa fa-sign-out-alt"></i> Logout
            </asp:LinkButton>
        </div>

        <!-- ===== MAIN CONTENT ===== -->
        <div class="content" id="mainContent">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>

        <!-- ===== FOOTER ===== -->
        <div class="footer">
            &copy; 2025 SAKRA WORLD HOSPITAL. All rights reserved.
        </div>

    </form>

    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById("sidebar");
            var content = document.getElementById("mainContent");
            if (sidebar && content) {
                sidebar.classList.toggle("open");
                content.classList.toggle("shift");
            }
        }

        function toggleUserMenu() {
            var menu = document.getElementById("userMenu");
            if (menu) menu.classList.toggle("show");
        }

        document.addEventListener("click", function (e) {
            var headerRight = document.querySelector(".header-right");
            var menu = document.getElementById("userMenu");
            if (menu && headerRight && !headerRight.contains(e.target)) {
                menu.classList.remove("show");
            }
        });
    </script>

</body>
</html>
